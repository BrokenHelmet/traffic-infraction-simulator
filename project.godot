; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Traffic Infraction Simulator"
config/version="0.0.1"
run/main_scene="res://scenes/app_root.tscn"
config/features=PackedStringArray("4.6")
run/max_fps=60
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/initial_position_type=3
window/size/initial_screen=2
window/stretch/mode="viewport"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/sk_fly_camera/plugin.cfg")

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="Environment"
3d_physics/layer_2="Vehicle_Infractions"
3d_navigation/layer_3="Pedestrian_Walkways"
avoidance/layer_1="Vehicle"
avoidance/layer_2="Traffic_Light_Sensor"
avoidance/layer_3="Pedestrian"
avoidance/layer_4="Static_Obstacle"
avoidance/layer_5="Emergency_Vehicle"
avoidance/layer_6="Pedestrian_Sensor"
avoidance/layer_7="Vehicle_Sensor"
avoidance/layer_8="Road_Surface"
avoidance/layer_9="Sidewalk"
avoidance/layer_10="Intersection_Zone"
avoidance/layer_11="Parking_Zone"
avoidance/layer_12="No_Parking_Zone"
avoidance/layer_13="Speed_Zone"
avoidance/layer_14="One_Way_Zone"
avoidance/layer_15="Construction_Zone"
avoidance/layer_16="Camera_Collision"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
driver/depth_prepass/enable=false
memory/limits/message_queue/max_size_mb=32
